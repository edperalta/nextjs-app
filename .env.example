# Database Configuration
DATABASE_URL="mysql://nextjs_user:nextjs_password@localhost:3306/nextjs_db"

# MySQL Container Settings
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=nextjs_db
MYSQL_USER=nextjs_user
MYSQL_PASSWORD=nextjs_password
MYSQL_PORT=3306

# phpMyAdmin Port
PHPMYADMIN_PORT=8080

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# better-auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — get credentials at console.cloud.google.com)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — get credentials at github.com/settings/developers)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
