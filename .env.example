# Database Configuration
DATABASE_URL="postgresql://nextjs_user:postgres_password@localhost:5432/nextjs_db"

# PostgreSQL Container Settings
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=nextjs_db
POSTGRES_USER=nextjs_user
POSTGRES_PORT=5432

# pgAdmin Settings
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin_password
PGADMIN_PORT=8080

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# better-auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (optional — get credentials at console.cloud.google.com)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional — get credentials at github.com/settings/developers)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
